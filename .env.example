# Azure Storage Configuration
AZURE_STORAGE_CONNECTION_STRING=your_connection_string_here
AZURE_STORAGE_CONTAINER_NAME=your_container_name_here

# OpenAI Configuration (Option A: Cloud API)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4
OPENAI_API_TYPE=openai  # or azure

# Azure OpenAI Configuration (if using Azure OpenAI)
AZURE_OPENAI_ENDPOINT=your_azure_openai_endpoint
AZURE_OPENAI_API_KEY=your_azure_openai_key
AZURE_OPENAI_DEPLOYMENT=your_deployment_name
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# LLM Provider Selection
LLM_PROVIDER=openai  # Options: openai, azure_openai, ollama

# Ollama Configuration (Option B: Local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# Processing Configuration
MAX_FILES=100  # Set to limit files for pilot runs, or -1 for all
PREVIEW_SIZE_KB=4  # Size of preview snippet to extract
LLM_CONFIDENCE_THRESHOLD=0.95
SELF_CONSISTENCY_RUNS=3
BATCH_SIZE=20
